{
  // Browser caches. Each rule is skipped if the browser is running.
  // Cache only. No cookies, history or passwords.
  // name and description are in English. The optional nameFi and descriptionFi fields hold
  // the Finnish texts; if they are missing, the English text is used in both languages.
  "schemaVersion": 1,
  "rules": [
    {
      "id": "edge-cache",
      "name": "Microsoft Edge cache",
      "nameFi": "Microsoft Edge -välimuisti",
      "category": "Browsers",
      "description": "Page cache. Pages load more slowly the first time.",
      "descriptionFi": "Sivujen välimuisti. Sivut latautuvat ensimmäisellä kerralla hitaammin.",
      "paths": [
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Cache",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Code Cache",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\GPUCache"
      ],
      "minAgeHours": 0,
      "risk": "Medium",
      "skipIfProcessRunning": [ "msedge" ]
    },
    {
      "id": "chrome-cache",
      "name": "Google Chrome cache",
      "nameFi": "Google Chrome -välimuisti",
      "category": "Browsers",
      "description": "Page cache.",
      "descriptionFi": "Sivujen välimuisti.",
      "paths": [
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Cache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Code Cache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\GPUCache"
      ],
      "minAgeHours": 0,
      "risk": "Medium",
      "skipIfProcessRunning": [ "chrome" ]
    },
    {
      "id": "firefox-cache",
      "name": "Mozilla Firefox cache",
      "nameFi": "Mozilla Firefox -välimuisti",
      "category": "Browsers",
      "description": "Page cache.",
      "descriptionFi": "Sivujen välimuisti.",
      "paths": [
        "%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles\\*\\cache2"
      ],
      "minAgeHours": 0,
      "risk": "Medium",
      "skipIfProcessRunning": [ "firefox" ]
    },
    {
      "id": "brave-cache",
      "name": "Brave cache",
      "nameFi": "Brave-välimuisti",
      "category": "Browsers",
      "description": "Page cache.",
      "descriptionFi": "Sivujen välimuisti.",
      "paths": [
        "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\*\\Cache",
        "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\*\\Code Cache"
      ],
      "minAgeHours": 0,
      "risk": "Medium",
      "skipIfProcessRunning": [ "brave" ]
    }
  ]
}
