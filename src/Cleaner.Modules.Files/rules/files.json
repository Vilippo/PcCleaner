{
  // Comments are allowed in this file.
  // Paths support environment variables (%TEMP%) and one wildcard (*) at the folder level.
  // MinAgeHours: only files that have not been modified in this many hours are removed.
  // name and description are in English. The optional nameFi and descriptionFi fields hold
  // the Finnish texts; if they are missing, the English text is used in both languages.
  "schemaVersion": 1,
  "rules": [
    {
      "id": "user-temp",
      "name": "User temporary files",
      "nameFi": "Käyttäjän väliaikaistiedostot",
      "category": "Windows",
      "description": "Temporary files created by programs. Old ones are not needed.",
      "descriptionFi": "Ohjelmien väliaikaistiedostot. Vanhoja ei tarvita.",
      "paths": [ "%TEMP%" ],
      "minAgeHours": 24,
      "risk": "Low"
    },
    {
      "id": "windows-temp",
      "name": "Windows temporary files",
      "nameFi": "Windowsin väliaikaistiedostot",
      "category": "Windows",
      "description": "System temporary files.",
      "descriptionFi": "Järjestelmän väliaikaistiedostot.",
      "paths": [ "%WINDIR%\\Temp" ],
      "minAgeHours": 24,
      "risk": "Low",
      "requiresAdmin": true
    },
    {
      "id": "windows-update-cache",
      "name": "Windows Update cache",
      "nameFi": "Windows Update -välimuisti",
      "category": "Windows",
      "description": "Downloaded update packages that are already installed. Windows downloads them again if needed.",
      "descriptionFi": "Ladatut päivityspaketit, jotka on jo asennettu. Windows lataa tarvittaessa uudelleen.",
      "paths": [ "%WINDIR%\\SoftwareDistribution\\Download" ],
      "minAgeHours": 240,
      "risk": "Low",
      "requiresAdmin": true
    },
    {
      "id": "delivery-optimization",
      "name": "Delivery Optimization cache",
      "nameFi": "Delivery Optimization -välimuisti",
      "category": "Windows",
      "description": "Cache for sharing updates.",
      "descriptionFi": "Päivitysten jakovälimuisti.",
      "paths": [ "%WINDIR%\\SoftwareDistribution\\DeliveryOptimization" ],
      "minAgeHours": 240,
      "risk": "Low",
      "requiresAdmin": true
    },
    {
      "id": "thumbnail-cache",
      "name": "Thumbnail cache",
      "nameFi": "Pikkukuvavälimuisti",
      "category": "Windows",
      "description": "File Explorer thumbnails. Windows recreates them.",
      "descriptionFi": "Resurssienhallinnan pikkukuvat. Windows luo ne uudelleen.",
      "paths": [ "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer" ],
      "patterns": [ "thumbcache_*.db", "iconcache_*.db" ],
      "recursive": false,
      "minAgeHours": 0,
      "risk": "Low",
      "skipIfProcessRunning": []
    },
    {
      "id": "windows-logs",
      "name": "Windows log files",
      "nameFi": "Windowsin lokitiedostot",
      "category": "Windows",
      "description": "Old .log files in the Windows folder.",
      "descriptionFi": "Vanhat .log-tiedostot Windows-kansiossa.",
      "paths": [ "%WINDIR%\\Logs" ],
      "patterns": [ "*.log", "*.etl" ],
      "minAgeHours": 168,
      "risk": "Low",
      "requiresAdmin": true
    },
    {
      "id": "memory-dumps",
      "name": "Memory dumps",
      "nameFi": "Muistivedokset",
      "category": "Windows",
      "description": "Crash memory dumps. Useful only for troubleshooting.",
      "descriptionFi": "Kaatumisten muistivedokset. Hyödyllisiä vain vianetsinnässä.",
      "paths": [ "%WINDIR%\\Minidump", "%LOCALAPPDATA%\\CrashDumps" ],
      "patterns": [ "*.dmp" ],
      "minAgeHours": 0,
      "risk": "Low",
      "requiresAdmin": true
    },
    {
      "id": "prefetch",
      "name": "Prefetch files",
      "nameFi": "Prefetch-tiedostot",
      "category": "Windows",
      "description": "Startup speed-up data. Removing it temporarily slows down opening programs, so it is not selected by default.",
      "descriptionFi": "Käynnistyksen nopeutusdata. Poisto hidastaa ohjelmien avaamista hetkellisesti – siksi ei oletuksena.",
      "paths": [ "%WINDIR%\\Prefetch" ],
      "patterns": [ "*.pf" ],
      "minAgeHours": 720,
      "risk": "Medium",
      "requiresAdmin": true,
      "enabledByDefault": false
    },
    {
      "id": "windows-old",
      "name": "Previous Windows installation (Windows.old)",
      "nameFi": "Edellinen Windows-asennus (Windows.old)",
      "category": "Windows",
      "description": "Backup of the previous version. After removal, the update cannot be rolled back.",
      "descriptionFi": "Edellisen version varmuuskopio. Poiston jälkeen päivitystä ei voi peruuttaa.",
      "paths": [ "%SYSTEMDRIVE%\\Windows.old" ],
      "minAgeHours": 0,
      "risk": "High",
      "requiresAdmin": true,
      "enabledByDefault": false
    }
  ]
}
