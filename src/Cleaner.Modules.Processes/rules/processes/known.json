{
  // Tunnetut taustaprosessit Prosessit-moduulille. Osuma antaa kategorian "Tunnetut taustaprosessit" ja
  // nimen kuvaukseen. Tiedosto ei poista mitään levyltä: moduuli vain lopettaa käyttäjän valitsemat prosessit.
  // match: prosessin nimen jokerikuviot (* ja ?), kirjainkoko ei merkitse, .exe-pääte saa puuttua.
  // risk: Low | Medium | High (oletus Medium).
  "schemaVersion": 1,
  "rules": [
    {
      "id": "google-crash-handler",
      "name": "Google Crash Handler",
      "match": ["GoogleCrashHandler.exe", "GoogleCrashHandler64.exe"],
      "description": "Googlen päivittäjän kaatumisraportoija, pyörii Chromen ja Driven sulkemisen jälkeen",
      "risk": "Medium"
    },
    {
      "id": "adobe-ipc-broker",
      "name": "Adobe IPC Broker",
      "match": ["AdobeIPCBroker.exe"],
      "description": "Adoben sovellusten välinen viestinvälittäjä, jää pyörimään Creative Cloud -ohjelmien sulkemisen jälkeen",
      "risk": "Medium"
    },
    {
      "id": "adobe-ccx-process",
      "name": "Adobe Creative Cloud Experience",
      "match": ["CCXProcess.exe"],
      "description": "Creative Cloudin taustapalvelu, joka lataa suosituksia ja mainoksia",
      "risk": "Medium"
    },
    {
      "id": "adobe-collab-sync",
      "name": "Adobe Collab Sync",
      "match": ["AdobeCollabSync.exe"],
      "description": "Acrobatin pilvisynkronointi, pyörii Acrobatin sulkemisen jälkeen",
      "risk": "Medium"
    },
    {
      "id": "steam-webhelper",
      "name": "Steam Web Helper",
      "match": ["steamwebhelper.exe"],
      "description": "Steamin selainmoottori, Steam käynnistää sen tarvittaessa uudelleen",
      "risk": "Low"
    },
    {
      "id": "discord-helper",
      "name": "Discord",
      "match": ["Discord*.exe"],
      "description": "Discordin prosessit; kun pääikkuna on auki, ryhmä näkyy avoimena ohjelmana",
      "risk": "Low"
    }
  ]
}
