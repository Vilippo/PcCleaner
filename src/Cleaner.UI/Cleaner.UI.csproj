<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Cleaner.UI</RootNamespace>
    <AssemblyName>PcCleaner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Exen kuvake (Resurssienhallinta, tehtäväpalkki). Generoitu: tools\make-icon.ps1 -->
    <ApplicationIcon>Assets\PcCleaner.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <!-- Ilman tätä "dotnet publish src\Cleaner.UI" ajaa AnyCPU-alustalla, jolloin XAML- ja PRI-vaiheet jäävät pois
         ja exe kaatuu käynnistyksessä (0xC000027B, combase.dll). Solution-build antaa alustan sln:stä. -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWinUI>true</UseWinUI>
    <!-- Pakkaamaton (ei MSIX) sovellus, Windows App SDK -ajonaika kopioidaan ohjelman viereen. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Viitatut kirjastot ovat Any CPU, tämä x64: ei varoitusta arkkitehtuurierosta. -->
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cleaner.Core\Cleaner.Core.csproj" />
    <ProjectReference Include="..\Cleaner.Modules.Files\Cleaner.Modules.Files.csproj" />
    <ProjectReference Include="..\Cleaner.Modules.Startup\Cleaner.Modules.Startup.csproj" />
    <ProjectReference Include="..\Cleaner.Modules.DiskUsage\Cleaner.Modules.DiskUsage.csproj" />
    <ProjectReference Include="..\Cleaner.Modules.Registry\Cleaner.Modules.Registry.csproj" />
    <ProjectReference Include="..\Cleaner.Modules.Uninstall\Cleaner.Modules.Uninstall.csproj" />
    <ProjectReference Include="..\Cleaner.Modules.Processes\Cleaner.Modules.Processes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <!-- Ikkunan kuvake ladataan ajon aikana tiedostosta (AppWindow.SetIcon), joten se kopioidaan exen viereen. -->
    <Content Include="Assets\PcCleaner.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- dotnet publish ei kopioi pakkaamattoman sovelluksen omaa .pri-tiedostoa eikä .xbf-tiedostoja
       julkaisukansioon (Windows App SDK 1.8). Ilman niitä exe kaatuu käynnistyksessä. -->
  <Target Name="CopyPriAndXbfToPublishDir" AfterTargets="Publish">
    <ItemGroup>
      <_UiResourceFiles Include="$(OutDir)$(AssemblyName).pri;$(OutDir)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_UiResourceFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
