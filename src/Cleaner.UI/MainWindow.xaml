<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Cleaner.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Cleaner.UI.ViewModels"
    Title="PC Cleaner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tavallinen käyttäjä: tarjotaan uudelleenkäynnistys adminina, ei pakoteta. -->
        <InfoBar Grid.Row="0"
                 IsOpen="{x:Bind ViewModel.ShowElevationHint}"
                 IsClosable="True"
                 Severity="Informational"
                 Title="Tavallinen käyttäjä"
                 Message="Järjestelmäkansiot (Windows\Temp, SoftwareDistribution) ja HKLM-käynnistyskohteet ohitetaan ilman järjestelmänvalvojan oikeuksia.">
            <InfoBar.ActionButton>
                <Button Content="Käynnistä uudelleen järjestelmänvalvojana"
                        Command="{x:Bind ViewModel.RestartElevatedCommand}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <NavigationView Grid.Row="1"
                        x:Name="Nav"
                        MenuItemsSource="{x:Bind ViewModel.Modules}"
                        SelectionChanged="Nav_SelectionChanged"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left"
                        OpenPaneLength="240"
                        PaneTitle="Moduulit">
            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="vm:ModuleViewModel">
                    <NavigationViewItem Content="{x:Bind DisplayName}"
                                        ToolTipService.ToolTip="{x:Bind Description}">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="{x:Bind Glyph}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <NavigationView.PaneFooter>
                <StackPanel Padding="12,8" Spacing="4">
                    <Button Content="Skannaa kaikki"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.ScanAllCommand}"
                            ToolTipService.ToolTip="Skannaa kaikki moduulit, jotka kuuluvat oletussiivoukseen" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <!-- Valitun moduulin sivu -->
            <Grid Padding="24,16,24,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.SelectedModule.DisplayName, Mode=OneWay}"
                               Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedModule.Description, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.SelectedModule.RiskText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedModule.AdminHint, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.SelectedModule.OptInHint, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <!-- Levytilan analyysi: polku, top-N ja treemap -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsDiskUsageSelected, Mode=OneWay}" Spacing="8" Margin="0,8,0,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Header="Kansio"
                                     PlaceholderText="Tyhjä = kaikki kiinteät asemat"
                                     Text="{x:Bind ViewModel.DiskUsagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Selaa..." VerticalAlignment="Bottom" Click="PickFolder_Click" />
                            <NumberBox Grid.Column="2" Header="Top-N" Minimum="1" Maximum="500" SmallChange="5"
                                       SpinButtonPlacementMode="Compact" MinWidth="120"
                                       Value="{x:Bind ViewModel.DiskUsageTop, Mode=TwoWay}" />
                        </Grid>
                        <Grid Visibility="{x:Bind ViewModel.HasTreemap, Mode=OneWay}" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="TreemapUpButton" Content="Ylös" Click="TreemapUp_Click" IsEnabled="False" />
                                <TextBlock Grid.Column="1" x:Name="TreemapPathText" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Grid>
                            <Border Grid.Row="1" Height="300" BorderThickness="1" CornerRadius="4"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <Canvas x:Name="TreemapCanvas" SizeChanged="TreemapCanvas_SizeChanged" />
                            </Border>
                        </Grid>
                    </StackPanel>
                    <!-- Ohjelman poisto: haku, ohjelmalista ja poistonapit -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsUninstallSelected, Mode=OneWay}" Spacing="8" Margin="0,8,0,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" PlaceholderText="Hae ohjelmaa nimellä tai julkaisijalla"
                                     Text="{x:Bind ViewModel.ProgramFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Grid.Column="1" MinWidth="220"
                                      Header=""
                                      SelectedIndex="{x:Bind ViewModel.ProgramSortIndex, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Listan järjestys">
                                <ComboBoxItem Content="Nimi" />
                                <ComboBoxItem Content="Asennuspäivä, uusin ensin" />
                            </ComboBox>
                        </Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.Programs, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedProgram, Mode=TwoWay}"
                                  MaxHeight="260"
                                  SelectionMode="Single"
                                  BorderThickness="1"
                                  CornerRadius="4"
                                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:InstalledProgramViewModel">
                                    <Grid ColumnSpacing="12" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Version}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Publisher}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind InstallDateText}"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   ToolTipService.ToolTip="Asennuspäivä" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind SizeText}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Päivitä lista" Command="{x:Bind ViewModel.RefreshProgramsCommand}" />
                            <Button Content="Poista ohjelma"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.UninstallProgramCommand}" />
                            <Button Content="Etsi jäänteet" Command="{x:Bind ViewModel.ScanLeftoversCommand}" />
                        </StackPanel>
                        <TextBlock Text="Poista ohjelma ajaa ohjelman oman poisto-ohjelman ja etsii sen jälkeen jäänteet. Jäänteet siirretään karanteeniin, josta Palauta varmuuskopio... tuo ne takaisin."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.SelectedModule.StatusText, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,8,0,0" />
                </StackPanel>

                <InfoBar Grid.Row="1"
                         Margin="0,8,0,0"
                         IsOpen="{x:Bind ViewModel.SelectedModule.HasErrors, Mode=OneWay}"
                         IsClosable="False"
                         Severity="Warning"
                         Title="Huomautukset"
                         Message="{x:Bind ViewModel.SelectedModule.ErrorText, Mode=OneWay}" />

                <ScrollViewer Grid.Row="2" Margin="0,8,0,0">
                    <StackPanel Spacing="8">

                        <!-- Matalan ja keskiriskin kategoriat -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedModule.Categories, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryViewModel">
                                    <Expander HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              Margin="0,0,0,8"
                                              IsExpanded="False">
                                        <Expander.Header>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          MinWidth="0"
                                                          IsThreeState="False"
                                                          IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock Text="{x:Bind RiskText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind SummaryText}"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource BodyTextBlockStyle}" />
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{x:Bind VisibleItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ItemViewModel">
                                                        <Grid ColumnSpacing="8" Padding="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" MinWidth="0"
                                                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis"
                                                                           Style="{StaticResource BodyTextBlockStyle}" />
                                                                <TextBlock Text="{x:Bind Description}"
                                                                           Visibility="{x:Bind HasDescription}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}"
                                                                       VerticalAlignment="Center"
                                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{x:Bind HiddenText}"
                                                       Visibility="{x:Bind HasHidden}"
                                                       Margin="0,8,0,0"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Korkean riskin kohteet: erillinen, oletuksena kiinni, ei valittuna -->
                        <Expander Visibility="{x:Bind ViewModel.SelectedModule.HasHighRisk, Mode=OneWay}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  IsExpanded="False">
                            <Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="Korkean riskin kohteet" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Text="Ei koskaan valittuna oletuksena. Tarkista jokainen kohde ennen valintaa."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedModule.HighRiskCategories, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CategoryViewModel">
                                        <Expander HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch"
                                                  Margin="0,0,0,8"
                                                  IsExpanded="False">
                                            <Expander.Header>
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" MinWidth="0" IsThreeState="False"
                                                              IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind SummaryText}" VerticalAlignment="Center"
                                                               Style="{StaticResource BodyTextBlockStyle}" />
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{x:Bind VisibleItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ItemViewModel">
                                                            <Grid ColumnSpacing="8" Padding="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox Grid.Column="0" MinWidth="0"
                                                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis"
                                                                               Style="{StaticResource BodyTextBlockStyle}" />
                                                                    <TextBlock Text="{x:Bind Description}"
                                                                               Visibility="{x:Bind HasDescription}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="{x:Bind SizeText}"
                                                                           VerticalAlignment="Center"
                                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{x:Bind HiddenText}"
                                                           Visibility="{x:Bind HasHidden}"
                                                           Margin="0,8,0,0"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <TextBlock Text="Ei löydöksiä."
                                   Visibility="{x:Bind ViewModel.SelectedModule.IsEmpty, Mode=OneWay}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <!-- Alapalkki: edistyminen, yhteenveto, napit, loki -->
        <StackPanel Grid.Row="2"
                    Padding="24,8,24,12"
                    Spacing="8"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">

            <StackPanel Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.BusyTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{x:Bind ViewModel.SelectedModule.SelectionText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}" />
                <Button Grid.Column="1" Content="Palauta varmuuskopio..."
                        Visibility="{x:Bind ViewModel.ShowRestoreButton, Mode=OneWay}"
                        Command="{x:Bind ViewModel.RestoreBackupCommand}"
                        ToolTipService.ToolTip="Tuo aiemman ajon rekisterivarmuuskopiot ja karanteeniin siirretyt kohteet takaisin" />
                <Button Grid.Column="2" Content="Peruuta"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Command="{x:Bind ViewModel.CancelCommand}" />
                <Button Grid.Column="3" Content="Skannaa"
                        MinWidth="120"
                        Command="{x:Bind ViewModel.ScanCommand}" />
                <Button Grid.Column="4" Content="Puhdista"
                        MinWidth="120"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.CleanCommand}" />
            </Grid>

            <Expander Header="Loki" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                <StackPanel Spacing="4">
                    <ListView ItemsSource="{x:Bind ViewModel.LogLines}"
                              MaxHeight="180"
                              SelectionMode="None"
                              IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="4,1" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Tyhjennä" Command="{x:Bind ViewModel.ClearLogCommand}" />
                        <TextBlock Text="{x:Bind ViewModel.LogPath}" VerticalAlignment="Center" IsTextSelectionEnabled="True"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Grid>
</Window>
